{
  "name": "react-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:html": "tsc && vite build --mode html",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "check": "tsc && biome check . && vite build --mode html",
    "audit": "bun audit --audit-level=moderate",
    "deps:outdated": "bun outdated",
    "deps:update": "bun scripts/update-deps.ts",
    "deps:update:latest": "bun scripts/update-deps.ts --latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "apache-arrow": "^21.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
